# Flask 密钥（用于 session 签名，请自行生成随机字符串）
FLASK_SECRET_KEY=your-secret-key-change-me

# Fernet 加密密钥（用于加密钱包私钥）
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key-change-me

# OpenAI API 密钥（用于 AI 生成任务）
OPENAI_API_KEY=sk-your-openai-api-key

# Bitrefill API 密钥（Bearer token）
BITREFILL_API_KEY=your-bitrefill-api-key

# Infura / Alchemy RPC URL（以太坊 Sepolia 测试网）
WEB3_PROVIDER_URI=https://sepolia.infura.io/v3/your-project-id
